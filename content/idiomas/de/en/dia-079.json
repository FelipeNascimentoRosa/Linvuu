        "titulo": "The 14 most common A1 mistakes",
        "explicacao": "Read each pair out loud: first the wrong one (to recognize how odd it sounds), then the right one. Fixing just these 14 makes your German far more natural.",
        "erros": [
          {
            "errado": "Tust du hier wohnen?",
            "certo": "Wohnst du hier?",
            "motivo": "No \"do\" in German: the verb itself opens the question."
          },
          {
            "errado": "Ich heute arbeite.",
            "certo": "Heute arbeite ich.",
            "motivo": "Verb in 2nd position."
          },
          {
            "errado": "Ich möchte essen einen Fisch.",
            "certo": "Ich möchte einen Fisch essen.",
            "motivo": "The second verb goes to the END."
          },
          {
            "errado": "Ich esse der Käse.",
            "certo": "Ich esse den Käse.",
            "motivo": "Masculine direct object: den."
          },
          {
            "errado": "Du esst Brot.",
            "certo": "Du isst Brot.",
            "motivo": "e → i with «du»."
          },
          {
            "errado": "Ich aufstehe um sieben Uhr.",
            "certo": "Ich stehe um sieben Uhr auf.",
            "motivo": "Separable prefix at the end."
          },
          {
            "errado": "Ich habe nicht Zeit.",
            "certo": "Ich habe keine Zeit.",
            "motivo": "A noun: «kein»."
          },
          {
            "errado": "Ich sehe er.",
            "certo": "Ich sehe ihn.",
            "motivo": "Accusative pronoun: he → him = er → ihn."
          },
          {
            "errado": "Er kannt schwimmen.",
            "certo": "Er kann schwimmen.",
            "motivo": "With «er», the modal takes no -t."
          },
          {
            "errado": "Sie öffnen das Buch!",
            "certo": "Öffnen Sie das Buch!",
            "motivo": "Imperative: verb before «Sie»."
          },
          {
            "errado": "Ich gehe im Kino.",
            "certo": "Ich gehe ins Kino.",
            "motivo": "Movement: accusative."
          },
          {
            "errado": "Es gibt ein Balkon.",
            "certo": "Es gibt einen Balkon.",
            "motivo": "«es gibt» takes the accusative."
          },
          {
            "errado": "halb drei = 3:30",
            "certo": "halb drei = 2:30",
            "motivo": "«halb» is half an hour BEFORE."
          },
          {
            "errado": "Ich bin ein Lehrer.",
            "certo": "Ich bin Lehrer.",
            "motivo": "No article before a job — unlike \"I'm a teacher\"."
          },
          {
            "errado": "Hier musst du nicht rauchen. (= you mustn't)",
            "certo": "Hier darfst du nicht rauchen.",
            "motivo": "English \"mustn't\" = darf nicht; muss nicht = don't have to."
          }
