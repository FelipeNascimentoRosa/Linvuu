            "errado": "Sono mangiando",
            "certo": "sto mangiando",
            "motivo": "The progressive uses «stare», not «essere»."
          },
          {
            "errado": "Ho appena arrivato",
            "certo": "Sono appena arrivato",
            "motivo": "«Arrivare» takes «essere»."
          }
        ],
