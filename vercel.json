{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{content/**,conteudo/gramatica-ru.html,server-files/**,server-files/.vite/manifest.json}",
      "maxDuration": 60,
      "regions": [
        "gru1"
      ]
    }
  },
  "headers": [
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/assets/:file"
    }
  ],
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "destination": "/api/index",
      "source": "/(.*)"
    }
  ]
}
